# Environment Variables Example

# --- SITE CONFIG ---
NEXT_PUBLIC_SITE_URL=https://nhuty.dev

# --- ANALYTICS ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- EMAIL (Resend) ---
# Used for /api/contact form. Get it from https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Who to send emails TO (the owner of the portfolio)
CONTACT_EMAIL_TO=y2002bt@gmail.com
# From which domain (must be verified in Resend)
CONTACT_EMAIL_FROM=onboarding@resend.dev

# --- CHATBOT (OpenAI) ---
# Used for /api/chat. Get it from https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- COMMENTS (Giscus) ---
# Get these IDs from https://giscus.app/ after installing it on your repo
NEXT_PUBLIC_GISCUS_REPO=NguyenNhutY/nhut-portfolio
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxxx
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxx
